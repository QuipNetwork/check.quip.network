# SPDX-License-Identifier: AGPL-3.0-or-later
# Build the Go binary
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app
COPY go.mod go.sum ./
RUN GOTOOLCHAIN=auto go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w" -o /check-quip .

# Build the certifier CLI from source.
# dnsimple-certifier is a separate private repo, not vendored here — run
# scripts/fetch-certifier.sh (or `make certifier-src`) to populate this path
# before building. The published certifier image ships only the server binary,
# so the CLI has to be built from source.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS certifier-builder

ARG TARGETOS
ARG TARGETARCH

COPY dnsimple-certifier /src
WORKDIR /src
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w" -o /certifier ./cmd/certifier/

# Runtime with nginx + certifier CLI for TLS. Pinned by digest because the
# trust store comes from this base, and a tag can move under a rebuild.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

COPY --from=builder /check-quip /usr/local/bin/check-quip
COPY --from=certifier-builder /certifier /usr/local/bin/certifier

# Install nginx and envsubst
RUN apk add --no-cache nginx gettext

# Stash the system trust store outside /etc/ssl. Flux mounts the app volume at
# /etc/ssl (containerData), and that mount shadows the image's contents — so
# the /probe tls, rpc, telemetry and dashboard checks, which verify against the
# system pool, would read whatever bundle the volume holds. entrypoint.sh
# copies these over the volume's at every boot.
#
# QUI-1923: the bundle must not trust the forged eMudhra chain. An upgrade that
# finds nothing newer exits 0, so the stashed files themselves are asserted,
# and the build fails if either still holds a bad root.
COPY scripts/assert-fixed-bundle.sh /tmp/assert-fixed-bundle.sh
RUN apk add --no-cache --upgrade ca-certificates-bundle \
    && mkdir -p /opt/ssl-defaults/certs \
    && cp /etc/ssl/cert.pem /opt/ssl-defaults/cert.pem \
    && cp /etc/ssl/certs/ca-certificates.crt /opt/ssl-defaults/certs/ca-certificates.crt \
    && sh /tmp/assert-fixed-bundle.sh /opt/ssl-defaults/cert.pem \
    && sh /tmp/assert-fixed-bundle.sh /opt/ssl-defaults/certs/ca-certificates.crt \
    && rm /tmp/assert-fixed-bundle.sh

# Nginx config template — domain substituted at runtime via envsubst
COPY nginx.conf /etc/nginx/nginx.conf.template

# Entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80 443

ENTRYPOINT ["/entrypoint.sh"]
